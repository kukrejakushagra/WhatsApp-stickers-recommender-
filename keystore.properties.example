# Copy to keystore.properties (gitignored) and fill in. Never commit the real file or the .jks.
# Create the key first:
#   keytool -genkeypair -v -keystore ~/keys/aistickersearch-upload.jks -storetype PKCS12 \
#     -alias upload -keyalg RSA -keysize 4096 -validity 10000
storeFile=/absolute/path/to/aistickersearch-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
